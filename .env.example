# ─── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── OpenAI (LLM fallback + STT + RAG embeddings) ────────────────────────────
OPENAI_API_KEY=your-openai-api-key

# ─── Primary call LLM (Settings → AI Model picks one of these) ───────────────
GROQ_API_KEY=your-groq-api-key
CEREBRAS_API_KEY=your-cerebras-api-key
TOGETHER_API_KEY=your-together-api-key

# ─── Uplift AI TTS (Urdu — Orator) ───────────────────────────────────────────
UPLIFT_API_KEY=your-uplift-api-key

# ─── ElevenLabs TTS (English) ────────────────────────────────────────────────
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# ─── Telnyx (telephony) ───────────────────────────────────────────────────────
TELNYX_API_KEY=your-telnyx-api-key
TELNYX_APP_ID=your-telnyx-connection-id
TELNYX_FROM_NUMBER=+923001234567
# Webhook signature verification (Ed25519 public key)
# How to get: Telnyx Dashboard → API Keys → click your key → copy "Public Key"
# It looks like: MCowBQYDK2VwAy...  (base64, starts with MC or similar)
TELNYX_WEBHOOK_PUBLIC_KEY=

# ─── Server ───────────────────────────────────────────────────────────────────
# PUBLIC_HOST: your public domain (no protocol) — used for WebSocket stream URL
# e.g. myserver.ngrok.io  or  myapp.fly.dev
PUBLIC_HOST=your-public-host.example.com
PORT=7860

# ─── Redis (optional — only needed for multi-worker deployments) ─────────────
# Leave empty for single-worker/dev — falls back to in-process memory.
# DigitalOcean Managed Redis/Valkey uses TLS: rediss://default:PASSWORD@HOST:PORT
REDIS_URL=

# ─── Uplift Voice IDs (optional — defaults below are used if not set) ─────────
# Urdu voices
VOICE_URDU_DEFAULT=v_8eelc901
VOICE_URDU_GEN_Z=v_kwmp7zxt
VOICE_URDU_DADA_JEE=v_yypgzenx
VOICE_URDU_NEWS=v_30s70t3a
# Regional voices
VOICE_SINDHI=v_sd0kl3m9
VOICE_BALOCHI=v_bl1de2f7
VOICE_ENGLISH=v_8eelc901
